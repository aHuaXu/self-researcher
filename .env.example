# Search Engine
SERPER_API_KEY=your-serper-api-key

# LLM - Executor (DeepResearcher 模型，用于 RL 训练)
EXECUTOR_MODEL=qwen-plus
EXECUTOR_BASE_URL=https://api.qwen.com/v1
EXECUTOR_API_KEY=your-api-key

# LLM - Small model (browse_webpage extraction)
SMALL_MODEL=qwen2.5-3b
SMALL_BASE_URL=https://api.qwen.com/v1
SMALL_API_KEY=your-api-key

# LLM - Summary model (用于摘要)
SUMMARY_MODEL=qwen-plus
SUMMARY_BASE_URL=https://api.qwen.com/v1
SUMMARY_API_KEY=your-api-key

# Search Config
SEARCH_ENGINE=google
SEARCH_TOP_K=10
SEARCH_REGION=us
SEARCH_LANG=en